{
  "workflow_id": "wf_intrusion",
  "description": "object detection -> intrusion. Simplest A->B: one frame, no state.",
  "nodes": [
    { "id": "A", "type": "object_detection", "kind": "camera_event",
      "camera": "cam_01", "generate_code": false,
      "emits": "region.person",
      "provides": ["bbox", "class_id", "confidence", "label", "track_id"] },

    { "id": "B", "type": "intrusion", "kind": "custom_analytic",
      "camera": "cam_01", "generate_code": true,
      "spec": {
        "requires": ["region.person"],
        "requires_fields": ["bbox", "track_id"],
        "frames": "1",
        "state": "none",
        "libraries": [],
        "emits": "event.usecase",
        "provides": ["track_ids", "person_count", "timestamp_us", "camera_id"],
        "params": { "polygon": "std::vector<SPt2f>", "target_class_id": "int",
                    "min_confidence_x100": "int" },
        "rule": "Emit one event listing every tracked object of the target class whose bounding box centre is inside the polygon.",
        "skeleton": "intrusion.txt"
      } }
  ],
  "edges": [ { "from": "A", "to": "B" } ],
  "testdata": { "frames": "testdata/frames_zone.json", "config": "testdata/cfg_intrusion.json" }
}
